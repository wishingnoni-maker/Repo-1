{
  "name": "employee-directory-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:schema": "node --import tsx ./scripts/applySchema.ts",
    "db:seed": "node --import tsx ./scripts/seedDatabase.ts",
    "db:reset": "node --import tsx ./scripts/resetDatabase.ts",
    "db:verify": "node --import tsx ./scripts/verifyDatabase.ts",
    "db:check": "node --import tsx ./scripts/verifyDatabase.ts",
    "db:seed:timesheet-demo": "node --import tsx ./scripts/seedTimesheetDemoProjects.ts",
    "db:seed:timesheet-demo-projects": "node --import tsx ./scripts/seedTimesheetDemoProjects.ts",
    "db:seed:time-entries-demo": "node --import tsx ./scripts/seedTimeEntriesDemo.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "multer": "^1.4.5-lts.1",
    "mssql": "^11.0.1",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
